# BotFlow API (no trailing slash).
# - Dev: leave unset → browser calls http://127.0.0.1:8000 directly (CORS allows :5173 when API is not production).
#   To use the Vite proxy instead: VITE_API_BASE_URL=/api/botflow (and BOTFLOW_PROXY_TARGET=http://127.0.0.1:8000).
# - Static host + API on another IP: same-origin proxy — e.g. VITE_API_BASE_URL=/api/botflow and nginx:
#     location /api/botflow/ { proxy_pass http://YOUR_API_IP/; ... }
# - Vercel: VITE_API_BASE_URL=/api/botflow and BOTFLOW_API_ORIGIN=http://YOUR_EC2:8000
# VITE_API_BASE_URL=

# Dev only — where Vite proxies /api/botflow (not exposed to the browser bundle).
# BOTFLOW_PROXY_TARGET=http://127.0.0.1:8000

# Vercel only — FastAPI origin for the serverless proxy (server-only).
# BOTFLOW_API_ORIGIN=http://YOUR_EC2_IP:8000

# Same secret as backend PORTAL_ADMIN_API_KEY (admin dashboard + onboarding API)
# VITE_ADMIN_API_KEY=
