# ── Supabase project (MUST match backend SUPABASE_URL) ────────────────────────
# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard → Project Settings → API → anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── BotFlow API (no trailing slash) ───────────────────────────────────────────
# - Dev: leave as /api/botflow → Vite proxy forwards to BOTFLOW_PROXY_TARGET.
# - Render static site: set to https://botflow-api.onrender.com in Render env vars.
# - Self-hosted nginx: set to /api/botflow and nginx must proxy /api/botflow/ → backend.
VITE_API_BASE_URL=/api/botflow

# Dev only — where Vite proxies /api/botflow (not exposed to the browser bundle).
BOTFLOW_PROXY_TARGET=http://127.0.0.1:8000

# Vercel only — FastAPI origin for the serverless proxy (server-only, not VITE_).
# BOTFLOW_API_ORIGIN=https://botflow-api.onrender.com

# Same secret as backend PORTAL_ADMIN_API_KEY (admin dashboard + onboarding API)
VITE_ADMIN_API_KEY=your-portal-admin-api-key
